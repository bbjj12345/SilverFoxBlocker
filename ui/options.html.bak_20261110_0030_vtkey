          <div class="rescue-ico rescue-ico-hr" data-page-node-id="fFlepUgj8imQ5WA6zx3SWm">
            <svg viewBox="0 0 24 24" fill="none" data-page-node-id="WuCUjlmSvAPOvmdZH9uCOp"><path d="M12 3 4 6v6c0 5 3.4 8.5 8 9 4.6-.5 8-4 8-9V6l-8-3Z" stroke="#7db4ff" stroke-width="1.5" stroke-linejoin="round" data-page-node-id="BEIrfiKKC3cxmHu3hNjq8x"/><path d="M9 12l2 2 4-4" stroke="#7db4ff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-page-node-id="F32pi3UdIiBUa13BzDMsG1"/></svg>
