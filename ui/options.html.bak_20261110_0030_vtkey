        <!-- Kaspersky Virus Removal Tool（KVRT）：卡巴斯基官方免费扫描器 -->
        <div class="card rescue-hero rescue-hero-kvrt" data-page-node-id="SF_KVRT_HERO">
          <div class="rescue-ico rescue-ico-kvrt" data-page-node-id="SF_KVRT_ICO">
            <svg viewBox="0 0 24 24" fill="none" data-page-node-id="SF_KVRT_SVG"><path d="M12 3 4 6v6c0 5 3.4 8.5 8 9 4.6-.5 8-4 8-9V6l-8-3Z" stroke="#ffb86b" stroke-width="1.5" stroke-linejoin="round" data-page-node-id="SF_KVRT_SVG_SHIELD"/><circle cx="11" cy="11" r="2.6" stroke="#ffb86b" stroke-width="1.6" data-page-node-id="SF_KVRT_SVG_C"/><path d="m13 13 2.4 2.4" stroke="#ffb86b" stroke-width="1.8" stroke-linecap="round" data-page-node-id="SF_KVRT_SVG_L"/></svg>
